<Window x:Class="AusbildungsWegInterview.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AusbildungsWeg Interview"
        Width="470" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop}"
        Background="#14151c" Foreground="#f3f4f8"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8ab4ff"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2b2d3a"/>
            <Setter Property="Foreground" Value="#f3f4f8"/>
            <Setter Property="BorderBrush" Value="#3a3d4d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">

        <!-- Status -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                     Fill="{Binding StatusBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"/>
        </Grid>
        <TextBlock Text="{Binding AiStatusText}" Foreground="#9aa0b6" FontSize="11" Margin="18,3,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding WhisperModelStatus}" Foreground="#9aa0b6" FontSize="11" Margin="18,1,0,6" TextWrapping="Wrap"/>

        <!-- Transport -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
            <Button Content="Start Listening" Command="{Binding StartCommand}" Width="132" Height="36" FontWeight="SemiBold"/>
            <Button Content="Stop" Command="{Binding StopCommand}" Width="72" Height="36" Margin="8,0,0,0"/>
            <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#f3f4f8"/>
        </StackPanel>

        <!-- Output device -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Output" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDevices}"
                      SelectedItem="{Binding SelectedOutputDevice}" DisplayMemberPath="Name"/>
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshDevicesCommand}" Margin="6,0,0,0" Width="66"/>
        </Grid>

        <!-- Transcript -->
        <TextBlock Text="Transcript (original)" Style="{StaticResource SectionHeader}"/>
        <Border Background="#1e2029" CornerRadius="6" Padding="8">
            <StackPanel>
                <TextBlock Text="{Binding TranscriptText}" TextWrapping="Wrap" FontSize="14" MinHeight="20"/>
                <TextBlock Text="provisional" Foreground="#f0a868" FontSize="11"
                           Visibility="{Binding IsTranscriptProvisional, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Translation -->
        <TextBlock Text="Translation" Style="{StaticResource SectionHeader}"/>
        <Border Background="#1e2029" CornerRadius="6" Padding="8">
            <TextBlock Text="{Binding TranslationText}" TextWrapping="Wrap" FontSize="14" MinHeight="20" Foreground="#cfe3ff"/>
        </Border>

        <!-- Suggested answer -->
        <TextBlock Text="Suggested answer" Style="{StaticResource SectionHeader}"/>
        <Border Background="#1e2029" CornerRadius="6" Padding="8">
            <StackPanel>
                <TextBlock Text="{Binding AnswerText}" TextWrapping="Wrap" FontSize="14" MinHeight="20"/>
                <TextBlock Text="provisional - refining" Foreground="#f0a868" FontSize="11"
                           Visibility="{Binding IsAnswerProvisional, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Settings -->
        <TextBlock Text="Settings" Style="{StaticResource SectionHeader}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source language" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Translate to" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding SelectedTargetLanguage}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Answer language" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding AnswerLanguages}" SelectedItem="{Binding SelectedAnswerLanguage}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Answer length" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding AnswerLengthOptions}" SelectedItem="{Binding SelectedAnswerLength}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Speech model" Margin="0,0,8,0"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="120" ItemsSource="{Binding WhisperModelOptions}" SelectedItem="{Binding SelectedWhisperModel}"/>
                <Button Content="Download" Command="{Binding DownloadModelCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Candidate context -->
        <TextBlock Text="Candidate context (local only)" Style="{StaticResource SectionHeader}"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Load CV" Command="{Binding LoadCvCommand}"/>
            <Button Content="Load job description" Command="{Binding LoadJobCommand}" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding ContextStatus}" Foreground="#9aa0b6" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <!-- Error -->
        <Border Background="#3a1f24" CornerRadius="6" Padding="8" Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ErrorText}" Foreground="#ff9a9a"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="OK" Command="{Binding ClearErrorCommand}" Margin="8,0,0,0" Padding="10,2"/>
            </Grid>
        </Border>

    </StackPanel>
</Window>

<Window x:Class="AusbildungsWegInterview.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AusbildungsWegInterview.App.ViewModels"
        Title="AusbildungsWeg Interview"
        Width="520" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop}"
        Background="#14151c" Foreground="#f3f4f8"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8ab4ff"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2b2d3a"/>
            <Setter Property="Foreground" Value="#f3f4f8"/>
            <Setter Property="BorderBrush" Value="#3a3d4d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">

        <!-- Status -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                     Fill="{Binding StatusBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"/>
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshStatusCommand}"
                    Margin="8,0,0,0" Padding="8,2" FontSize="11"/>
        </Grid>

        <!-- Explicit capture indicator: system audio only, never the microphone -->
        <Border Background="#12351f" CornerRadius="5" Padding="6" Margin="0,6,0,0"
                Visibility="{Binding IsCapturingSystemAudio, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="#7ee2a8" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap">
                <Run Text="&#x25CF; System audio is being captured (loopback of the selected output device). The microphone is NOT used."/>
            </TextBlock>
        </Border>

        <TextBlock Text="{Binding AiStatusText}" Foreground="#9aa0b6" FontSize="11" Margin="18,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SpeechSetupStatus}" Foreground="#9aa0b6" FontSize="11" Margin="18,1,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="Suggested local models for this machine (RAM-based, conservative): Ollama: {Binding SuggestedOllamaModel, Mode=OneWay} | Whisper: {Binding SuggestedWhisperModel, Mode=OneWay}"
                   Foreground="#6b7089" FontSize="10" Margin="18,1,0,6" TextWrapping="Wrap"/>

        <!-- Transport -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
            <Button Content="Start Listening" Command="{Binding StartCommand}" Width="132" Height="36" FontWeight="SemiBold"/>
            <Button Content="Stop" Command="{Binding StopCommand}" Width="72" Height="36" Margin="8,0,0,0"/>
            <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#f3f4f8"/>
        </StackPanel>

        <!-- Output device -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Output" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDevices}"
                      SelectedItem="{Binding SelectedOutputDevice}" DisplayMemberPath="Name"/>
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshDevicesCommand}" Margin="6,0,0,0" Width="66"/>
        </Grid>

        <!-- Transcript -->
        <TextBlock Text="Transcript (original)" Style="{StaticResource SectionHeader}"/>
        <Border Background="#1e2029" CornerRadius="6" Padding="8">
            <StackPanel>
                <TextBlock Text="{Binding TranscriptText}" TextWrapping="Wrap" FontSize="14" MinHeight="20"/>
                <TextBlock Text="provisional" Foreground="#f0a868" FontSize="11"
                           Visibility="{Binding IsTranscriptProvisional, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Detected question -->
        <TextBlock Text="Detected question" Style="{StaticResource SectionHeader}"/>
        <Border Background="#1e2029" CornerRadius="6" Padding="8">
            <Grid>
                <TextBlock Text="{Binding DetectedQuestionText}" TextWrapping="Wrap" FontSize="14" MinHeight="20"
                           Visibility="{Binding HasDetectedQuestion, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="No complete question detected yet." Foreground="#6b7089" FontSize="12"
                           Visibility="{Binding HasDetectedQuestion, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Translation -->
        <TextBlock Text="Translation" Style="{StaticResource SectionHeader}"/>
        <Border Background="#1e2029" CornerRadius="6" Padding="8">
            <StackPanel>
                <TextBlock Text="{Binding TranslationText}" TextWrapping="Wrap" FontSize="14" MinHeight="20" Foreground="#cfe3ff"/>
                <TextBlock Text="{Binding TranslationStatusText}" TextWrapping="Wrap" Foreground="#f0a868" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Suggested answer -->
        <TextBlock Text="Suggested answer" Style="{StaticResource SectionHeader}"/>
        <Border Background="#1e2029" CornerRadius="6" Padding="8">
            <StackPanel>
                <TextBlock Text="{Binding AnswerText}" TextWrapping="Wrap" FontSize="14" MinHeight="20"/>
                <TextBlock Text="provisional - refining" Foreground="#f0a868" FontSize="11"
                           Visibility="{Binding IsAnswerProvisional, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Settings -->
        <TextBlock Text="Settings" Style="{StaticResource SectionHeader}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source language" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Translate to" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding SelectedTargetLanguage}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Translation engine" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding TranslationEngineOptions}" SelectedItem="{Binding SelectedTranslationEngine}"/>

            <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Foreground="#f3f4f8" VerticalAlignment="Center"
                      Content="Enable translation (off = show original, clearly labeled)"
                      IsChecked="{Binding TranslationEnabled}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="External CLI" Margin="0,0,8,6" VerticalAlignment="Center"
                       ToolTip="Only used when the engine is 'External CLI'. Text goes via stdin; first stdout line is the translation."/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding TranslatorCliPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. C:\tools\mariannet.exe"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="External CLI args" Margin="0,0,8,6" VerticalAlignment="Center"
                       ToolTip="Template with {source} and {target} placeholders."/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding TranslatorCliArgs, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. &quot;mariannet -m C:\models\opus-mt-de-en.bin -s {source} -t {target} -i - -o -&quot;"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Answer language" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding AnswerLanguages}" SelectedItem="{Binding SelectedAnswerLanguage}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Answer length" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding AnswerLengthOptions}" SelectedItem="{Binding SelectedAnswerLength}"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Answer style" Margin="0,0,8,6"/>
            <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,0,0,6"
                      ItemsSource="{Binding AnswerStyleOptions}" SelectedItem="{Binding SelectedAnswerStyle}"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Speech model" Margin="0,0,8,6"/>
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="120" ItemsSource="{Binding WhisperModelOptions}" SelectedItem="{Binding SelectedWhisperModel}"/>
                <Button Content="Download" Command="{Binding DownloadModelCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Whisper CLI path" Margin="0,0,8,6" VerticalAlignment="Center" ToolTip="Path to whisper-cli (or main). Leave empty to use the built-in native library adapter."/>
            <TextBox Grid.Row="10" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding WhisperExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. C:\tools\whisper.cpp\build\bin\whisper-cli.exe  (applied when not listening)"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Model path" Margin="0,0,8,6" VerticalAlignment="Center" ToolTip="Explicit path to a ggml model file. Leave empty to use the app's model folder."/>
            <TextBox Grid.Row="11" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding WhisperModelPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. C:\tools\whisper.cpp\models\ggml-small.bin  (applied when not listening)"/>

            <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0"
                       Foreground="#6b7089" FontSize="10" TextWrapping="Wrap"
                       Text="Engine settings apply after Stop. whisper (→EN) reuses the speech model; External CLI needs a user-installed binary + models (never downloaded by the app)."/>

            <TextBlock Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0"
                       Foreground="#6b7089" FontSize="10" TextWrapping="Wrap"
                       Text="Only the selected output device is captured (system audio, loopback) - the microphone is never used."/>
        </Grid>

        <!-- Candidate context -->
        <TextBlock Text="Candidate context (local only)" Style="{StaticResource SectionHeader}"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Load CV" Command="{Binding LoadCvCommand}"/>
            <Button Content="Load job description" Command="{Binding LoadJobCommand}" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding ContextStatus}" Foreground="#9aa0b6" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <!-- Error -->
        <Border Background="#3a1f24" CornerRadius="6" Padding="8" Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ErrorText}" Foreground="#ff9a9a"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="OK" Command="{Binding ClearErrorCommand}" Margin="8,0,0,0" Padding="10,2"/>
            </Grid>
        </Border>

    </StackPanel>
</Window>

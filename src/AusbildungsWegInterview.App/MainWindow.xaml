<Window x:Class="AusbildungsWegInterview.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AusbildungsWegInterview.App.ViewModels"
        Title="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=TitleApp}"
        Width="1200" Height="840" MinWidth="960" MinHeight="640"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding IsRtl, Converter={StaticResource BoolToFlowDirection}}"
        Topmost="{Binding AlwaysOnTop}"
        Background="{DynamicResource AwShellBackgroundBrush}">

    <!-- Converters (BoolToVis, InverseBoolToVis, BoolToFlowDirection, LocKey,
         LevelToHeight, PickerEquals) live at Application scope in App.xaml. -->
    <Window.Resources>
        <Style x:Key="AwMiniLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AwMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="AwIconButton" TargetType="Button" BasedOn="{StaticResource AwButtonGhost}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="AwCopyButton" TargetType="Button" BasedOn="{StaticResource AwButtonGhost}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Content" Value="&#xE8C8;"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AwShellGradientBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ left navigation rail ============================ -->
        <Border Grid.Column="0" Width="94" Background="{DynamicResource AwNavRailBrush}"
                BorderBrush="{DynamicResource AwGlassBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Width="46" Height="46" Margin="0,18,0,14"
                        CornerRadius="14" Background="{DynamicResource AwNeonSoftBrush}">
                    <Image Source="/Assets/AwLogo.png" Width="34" Height="34" Margin="6"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding NavPrimary}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" Focusable="False">
                    ItemContainerStyle="{DynamicResource AwNavItem}"
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}" Style="{DynamicResource AwNavGlyph}"/>
                                <TextBlock Text="{Binding Label}" Style="{DynamicResource AwNavCaption}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding NavSecondary}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" Focusable="False" Margin="0,0,0,14">
                    ItemContainerStyle="{DynamicResource AwNavItem}"
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}" Style="{DynamicResource AwNavGlyph}"/>
                                <TextBlock Text="{Binding Label}" Style="{DynamicResource AwNavCaption}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- =============================== main column =============================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- = header = -->
            <Border Grid.Row="0" Padding="18,14" BorderBrush="{DynamicResource AwGlassBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="MAMADO" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AwInkBrush}"/>
                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=AppTagline}"
                                   FontSize="11.5" Foreground="{DynamicResource AwMutedBrush}"/>
                    </StackPanel>

                    <!-- real health checks only: Whisper / Ollama / Translation -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{DynamicResource AwPillBorder}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource AwPillOffBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WhisperPillReady}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AwPillReadyBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WhisperPillFaulted}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AwPillFaultBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel>
                                    <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=StatusWhisper}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AwInkBrush}"/>
                                    <TextBlock Text="{Binding WhisperPillState}" FontSize="11" Foreground="{DynamicResource AwMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwPillBorder}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource AwPillOffBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OllamaPillReady}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AwPillReadyBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OllamaPillFaulted}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AwPillFaultBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel>
                                    <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=StatusOllama}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AwInkBrush}"/>
                                    <TextBlock Text="{Binding OllamaPillState}" FontSize="11" Foreground="{DynamicResource AwMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwPillBorder}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource AwPillOffBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TranslationPillReady}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AwPillReadyBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TranslationPillFaulted}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AwPillFaultBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel>
                                    <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=StatusTranslation}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AwInkBrush}"/>
                                    <TextBlock Text="{Binding TranslationPillState}" FontSize="11" Foreground="{DynamicResource AwMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Style="{DynamicResource AwIconButton}" Content="&#xE713;"
                                Command="{Binding SelectPageCommand}" CommandParameter="settings"
                                ToolTip="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=NavSettings}"/>
                        <Button Style="{DynamicResource AwIconButton}" Content="&#xE81C;" Margin="4,0,0,0"
                                Command="{Binding SelectPageCommand}" CommandParameter="logs"
                                ToolTip="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=NavLogs}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- = pages = -->
            <ScrollViewer Background="{DynamicResource AwShellGradientBrush}"
                          Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel>

                    <!-- error banner (localized, no raw paths) -->
                    <Border Background="{DynamicResource AwDangerSoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{DynamicResource AwButtonGhost}" Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets" Command="{Binding ClearErrorCommand}"/>
                            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{DynamicResource AwInkBrush}"/>
                        </DockPanel>
                    </Border>

                    <!-- ==================== INTERVIEW page ==================== -->
                    <StackPanel Visibility="{Binding IsInterviewPage, Converter={StaticResource BoolToVis}}">

                        <!-- listening card -->
                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="62" Height="62" CornerRadius="31" Margin="0,0,16,0"
                                        Background="{DynamicResource AwNeonSoftBrush}"
                                        BorderBrush="{DynamicResource AwMicRingBrush}" BorderThickness="2"
                                        Effect="{DynamicResource AwNeonGlow}">
                                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AwNeonBrush}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AwInkBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=IdleHeading}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                        <Setter Property="Text" Value="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=ListeningHeading}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource AwMutedBrush}" Margin="0,2,0,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=IdleSub}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                        <Setter Property="Text" Value="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=ListeningSub}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- real capture levels (nothing simulated) -->
                                    <ItemsControl ItemsSource="{Binding WaveformLevels}" Height="38">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Width="2.5" Margin="0.7,0" RadiusX="1.2" RadiusY="1.2"
                                                           VerticalAlignment="Center"
                                                           Fill="{DynamicResource AwWaveBrush}"
                                                           Height="{Binding Converter={StaticResource LevelToHeight}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource AwMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="180">
                                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                                              Style="{DynamicResource AwComboBox}"
                                              ToolTip="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=OutputDevice}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <Button Style="{DynamicResource AwButtonPrimary}" Command="{Binding StartCommand}"
                                                Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=StartListening}"
                                                Visibility="{Binding IsListening, Converter={StaticResource InverseBoolToVis}}"/>
                                        <Button Style="{DynamicResource AwButtonDanger}" Command="{Binding StopCommand}"
                                                Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=Stop}"
                                                Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{DynamicResource AwButtonGhost}" Margin="8,0,0,0"
                                                Command="{Binding RefreshDevicesCommand}" Content="&#xE72C;"
                                                FontFamily="Segoe MDL2 Assets"
                                                ToolTip="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=Refresh}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- detected question trio -->
                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=QuestionLabel}"
                                   Style="{DynamicResource AwSectionLabel}"/>
                        <ItemsControl ItemsSource="{Binding QuestionPanels}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource AwGlassCard}" Margin="6" MinHeight="132">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Caption}" Style="{DynamicResource AwMiniLabel}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Style="{DynamicResource AwCopyButton}"
                                                        Command="{Binding CopyCommand}"
                                                        ToolTip="{Binding DataContext.T, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LocKey}, ConverterParameter=CopyAnswer}"/>
                                            </Grid>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StateText}" TextWrapping="Wrap"
                                                       FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource AwMutedBrush}"
                                                       Visibility="{Binding HasStateText, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="170"
                                                       FontSize="13.5" LineHeight="20" Foreground="{DynamicResource AwInkBrush}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- suggested answer trio -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=AnswerSectionHeading}"
                                       Style="{DynamicResource AwSectionLabel}"/>
                            <Border Grid.Column="1" Background="{DynamicResource AwWarningSoftBrush}" CornerRadius="999" Padding="8,2"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=AnswerGenerating}"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AwWarningBrush}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AnswerPanels}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource AwGlassCard}" Margin="6" MinHeight="150">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Caption}" Style="{DynamicResource AwMiniLabel}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Style="{DynamicResource AwCopyButton}"
                                                        Command="{Binding CopyCommand}"
                                                        ToolTip="{Binding DataContext.T, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LocKey}, ConverterParameter=CopyAnswer}"/>
                                            </Grid>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StateText}" TextWrapping="Wrap"
                                                       FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource AwMutedBrush}"
                                                       Visibility="{Binding HasStateText, Converter={StaticResource BoolToVis}}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="200"
                                                           FontSize="13.5" LineHeight="20" Foreground="{DynamicResource AwInkBrush}"/>
                                                <TextBlock Text="{Binding DataContext.T, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LocKey}, ConverterParameter=AnswerDisclaimer}"
                                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           Foreground="{DynamicResource AwFaintBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- answer controls: real re-generation + real settings -->
                        <Border Style="{DynamicResource AwGlassCard}" Margin="6,6,6,14" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Style="{DynamicResource AwButtonGhost}" Command="{Binding ShorterCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=BtnShorter}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonGhost}" Command="{Binding LongerCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=BtnLonger}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonSecondary}" Command="{Binding RegenerateCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=BtnRegenerate}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=AnswerStyleLabel}"
                                               FontSize="12" Foreground="{DynamicResource AwMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{DynamicResource AwSegmented}" GroupName="Length"
                                                     Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=LengthConcise}"
                                                     IsChecked="{Binding SelectedAnswerLength, Mode=OneWay, Converter={StaticResource PickerEquals}, ConverterParameter=Concise}"
                                                     Command="{Binding SetAnswerLengthCommand}" CommandParameter="Concise"/>
                                        <RadioButton Style="{DynamicResource AwSegmented}" GroupName="Length"
                                                     Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=LengthNormal}"
                                                     IsChecked="{Binding SelectedAnswerLength, Mode=OneWay, Converter={StaticResource PickerEquals}, ConverterParameter=Normal}"
                                                     Command="{Binding SetAnswerLengthCommand}" CommandParameter="Normal"/>
                                        <RadioButton Style="{DynamicResource AwSegmented}" GroupName="Length"
                                                     Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=LengthDetailed}"
                                                     IsChecked="{Binding SelectedAnswerLength, Mode=OneWay, Converter={StaticResource PickerEquals}, ConverterParameter=Detailed}"
                                                     Command="{Binding SetAnswerLengthCommand}" CommandParameter="Detailed"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding AnswerStyleOptions}" SelectedItem="{Binding SelectedAnswerStyle}"
                                              DisplayMemberPath="Display" Style="{DynamicResource AwComboBox}" Width="150" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- document context (resume / job description / notes) -->
                        <Border Style="{DynamicResource AwGlassCard}" Margin="6,0,6,14">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=ContextHeading}"
                                               Style="{DynamicResource AwSectionLabel}"/>
                                    <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocContextHint}"
                                               FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource AwMutedBrush}"/>
                                    <TextBlock Text="{Binding ContextStatus}" FontSize="11" Margin="0,6,0,0"
                                               Foreground="{DynamicResource AwMutedBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{DynamicResource AwButtonSecondary}" VerticalAlignment="Top"
                                        Click="AddDocument_Click"
                                        Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=BtnAddDocument}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocCvHeading}"
                                                      Command="{Binding LoadCvCommand}"/>
                                            <MenuItem Header="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocJobHeading}"
                                                      Command="{Binding LoadJdCommand}"/>
                                            <MenuItem Header="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocNotesHeading}"
                                                      Command="{Binding LoadNotesCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{DynamicResource AwChip}" Margin="0,0,8,0" Padding="12,8"
                                        Visibility="{Binding CvChip.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource AwCopyButton}" Content="&#xE711;"
                                                Command="{Binding CvChip.RemoveCommand}"
                                                ToolTip="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocChipRemove}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CvChip.FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AwInkBrush}"/>
                                            <TextBlock Text="{Binding CvChip.Meta}" FontSize="11" Foreground="{DynamicResource AwMutedBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{DynamicResource AwChip}" Margin="0,0,8,0" Padding="12,8"
                                        Visibility="{Binding JdChip.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource AwCopyButton}" Content="&#xE711;"
                                                Command="{Binding JdChip.RemoveCommand}"
                                                ToolTip="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocChipRemove}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding JdChip.FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AwInkBrush}"/>
                                            <TextBlock Text="{Binding JdChip.Meta}" FontSize="11" Foreground="{DynamicResource AwMutedBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{DynamicResource AwChip}" Padding="12,8"
                                        Visibility="{Binding NotesChip.IsVisible, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource AwCopyButton}" Content="&#xE711;"
                                                Command="{Binding NotesChip.RemoveCommand}"
                                                ToolTip="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocChipRemove}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding NotesChip.FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AwInkBrush}"/>
                                            <TextBlock Text="{Binding NotesChip.Meta}" FontSize="11" Foreground="{DynamicResource AwMutedBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- live transcript (kept available; provisional marked honestly) -->
                        <Border Style="{DynamicResource AwGlassCard}" Margin="6,0,6,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=TranscriptLabel}"
                                               Style="{DynamicResource AwMiniLabel}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource AwWarningSoftBrush}" CornerRadius="999" Padding="8,1"
                                            HorizontalAlignment="Left" Margin="8,0,0,4"
                                            Visibility="{Binding IsTranscriptProvisional, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=ProvisionalRefining}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AwWarningBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding TranscriptText}" TextWrapping="Wrap" FontSize="12.5" MaxHeight="120"
                                           LineHeight="18" Foreground="{DynamicResource AwMutedBrush}"/>
                                <TextBlock Text="{Binding AnswerText}" TextWrapping="Wrap" FontSize="12.5" MaxHeight="120" Margin="0,8,0,0"
                                           LineHeight="18" Foreground="{DynamicResource AwInkBrush}"
                                           Visibility="{Binding AnswerIsSuggestion, Converter={StaticResource InverseBoolToVis}}"/>
                                <Button Style="{DynamicResource AwButtonGhost}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding CopyAnswerCommand}"
                                        Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=CopyAnswer}"
                                        Visibility="{Binding AnswerIsSuggestion, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== DOCUMENTS page ==================== -->
                    <StackPanel Visibility="{Binding IsDocumentsPage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocumentsHint}"
                                   FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource AwMutedBrush}" Margin="0,0,0,14"/>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocCvHeading}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{DynamicResource AwButtonSecondary}" Command="{Binding LoadCvCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocImport}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonPrimary}" Command="{Binding UseCvCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocUse}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonGhost}" Command="{Binding ClearCvCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocClear}"/>
                                </StackPanel>
                                <TextBox Text="{Binding CvText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AwTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="170"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="{Binding CvStateText}" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource AwMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocJobHeading}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{DynamicResource AwButtonSecondary}" Command="{Binding LoadJdCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocImport}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonPrimary}" Command="{Binding UseJdCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocUse}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonGhost}" Command="{Binding ClearJdCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocClear}"/>
                                </StackPanel>
                                <TextBox Text="{Binding JdText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AwTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="170"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="{Binding JdStateText}" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource AwMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocNotesHeading}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{DynamicResource AwButtonSecondary}" Command="{Binding LoadNotesCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocImport}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonPrimary}" Command="{Binding UseNotesCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocUse}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonGhost}" Command="{Binding ClearNotesCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocClear}"/>
                                </StackPanel>
                                <TextBox Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AwTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="170"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="{Binding NotesStateText}" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource AwMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DocPrivacy}"
                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource AwFaintBrush}"/>
                    </StackPanel>

                    <!-- ==================== SETTINGS page ==================== -->
                    <StackPanel Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=SettingsHint}"
                                   FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource AwMutedBrush}" Margin="0,0,0,14"/>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=SetupHeading}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=InterviewLanguage}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"
                                          Style="{DynamicResource AwComboBox}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=TranslationLanguage}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding SelectedTargetLanguage}"
                                          Style="{DynamicResource AwComboBox}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=AnswerLanguage}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AnswerLanguages}" SelectedItem="{Binding SelectedAnswerLanguage}"
                                          Style="{DynamicResource AwComboBox}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=AnswerLevel}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CefrLevelOptions}" SelectedItem="{Binding SelectedCefrLevel}"
                                          Style="{DynamicResource AwComboBox}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=SpeechHeading}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <TextBlock Text="{Binding SpeechSetupStatus}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AwMutedBrush}"/>
                                <TextBlock Text="{Binding ModelSuggestedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Foreground="{DynamicResource AwFaintBrush}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=WhisperCliPath}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <TextBox Text="{Binding WhisperExecutablePath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AwTextBox}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=ModelPath}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <TextBox Text="{Binding WhisperModelPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AwTextBox}"/>
                                 <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=SpeechModel}"
                                            Style="{DynamicResource AwFieldLabel}"/>
                                 <ComboBox ItemsSource="{Binding WhisperModelOptions}" SelectedItem="{Binding SelectedWhisperModel}"
                                           Style="{DynamicResource AwComboBox}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{DynamicResource AwButtonSecondary}" Command="{Binding DownloadModelCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=Download}" Margin="0,0,6,0"/>
                                    <Button Style="{DynamicResource AwButtonGhost}" Command="{Binding RefreshStatusCommand}"
                                            Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=Refresh}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=TranslationHeading}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <ComboBox ItemsSource="{Binding TranslationEngineOptions}" SelectedItem="{Binding SelectedTranslationEngine}"
                                          DisplayMemberPath="Display" Style="{DynamicResource AwComboBox}"/>
                                <CheckBox Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=EnableTranslation}"
                                          IsChecked="{Binding TranslationEnabled}" Style="{DynamicResource AwCheckBox}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=ExternalCliPath}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <TextBox Text="{Binding TranslatorCliPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AwTextBox}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=ExternalCliArgs}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <TextBox Text="{Binding TranslatorCliArgs, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AwTextBox}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=EngineHint}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource AwFaintBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=OllamaHeading}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <TextBlock Text="{Binding AiStatusText}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AwMutedBrush}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=OllamaModel}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <TextBox Text="{Binding OllamaModel, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AwTextBox}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=AdvancedHeading}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=UiLanguageTip}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding UiLanguageOptions}" SelectedItem="{Binding SelectedUiLanguage}"
                                          DisplayMemberPath="Display" Style="{DynamicResource AwComboBox}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=OutputDevice}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                                          Style="{DynamicResource AwComboBox}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=ThemeLight}"
                                           Style="{DynamicResource AwFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                          DisplayMemberPath="Display" Style="{DynamicResource AwComboBox}"/>
                                <CheckBox Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=AlwaysOnTop}"
                                          IsChecked="{Binding AlwaysOnTop}" Style="{DynamicResource AwCheckBox}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== LOGS page ==================== -->
                    <StackPanel Visibility="{Binding IsLogsPage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=LogsHint}"
                                   FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource AwMutedBrush}" Margin="0,0,0,10"/>
                        <Button Style="{DynamicResource AwButtonSecondary}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                Command="{Binding RefreshLogsCommand}"
                                Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=LogsRefresh}"/>
                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=LogsUnavailable}"
                                   FontSize="12" Foreground="{DynamicResource AwMutedBrush}"
                                   Visibility="{Binding LogsUnavailable, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=LogsEmpty}"
                                   FontSize="12" Foreground="{DynamicResource AwMutedBrush}"
                                   Visibility="{Binding HasLogLines, Converter={StaticResource InverseBoolToVis}}"/>
                        <Border Style="{DynamicResource AwGlassCard}" Padding="10">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AwMutedBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- ==================== FEEDBACK page ==================== -->
                    <StackPanel Visibility="{Binding IsFeedbackPage, Converter={StaticResource BoolToVis}}">
                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=NavFeedback}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=FeedbackHint}"
                                           FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource AwMutedBrush}"/>
                                <TextBlock Text="{Binding AppVersionText}" FontSize="12.5" Margin="0,10,0,0"
                                           Foreground="{DynamicResource AwInkBrush}"/>
                                <Button Style="{DynamicResource AwButtonSecondary}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Command="{Binding CopyDiagnosticsCommand}"
                                        Content="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=FeedbackCopyDiagnostics}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource AwGlassCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=FeedbackPrivacyTitle}"
                                           Style="{DynamicResource AwSectionLabel}"/>
                                <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=FeedbackPrivacyBody}"
                                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AwMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding T, Converter={StaticResource LocKey}, ConverterParameter=DisclosureNote}"
                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource AwFaintBrush}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

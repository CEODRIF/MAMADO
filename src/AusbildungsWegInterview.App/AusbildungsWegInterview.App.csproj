<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only WPF application (target: Windows 10 / 11). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>AusbildungsWegInterview.App</RootNamespace>
    <!-- Allows the WPF project to COMPILE on non-Windows CI hosts (still a
         Windows-only binary; it cannot run off-Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AusbildungsWegInterview</AssemblyName>
    <!-- User-facing file metadata (Windows file properties). The internal
         AssemblyName stays unchanged — only the display brand is renamed. -->
    <AssemblyTitle>AusbildungsWeg Interview</AssemblyTitle>
    <Product>AusbildungsWeg Interview</Product>
    <Description>AusbildungsWeg Interview - local-first AI interview assistant (WPF). Windows-only build.</Description>
    <!-- Windows application icon (exe/taskbar) - multi-size ICO, 16..256. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brand logo for the header (pack URI /Assets/AwLogo.png). -->
    <Resource Include="Assets\AwLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AusbildungsWegInterview.Core\AusbildungsWegInterview.Core.csproj" />
    <ProjectReference Include="..\AusbildungsWegInterview.Audio\AusbildungsWegInterview.Audio.csproj" />
    <ProjectReference Include="..\AusbildungsWegInterview.Speech\AusbildungsWegInterview.Speech.csproj" />
    <ProjectReference Include="..\AusbildungsWegInterview.Translation\AusbildungsWegInterview.Translation.csproj" />
    <ProjectReference Include="..\AusbildungsWegInterview.Answers\AusbildungsWegInterview.Answers.csproj" />
    <ProjectReference Include="..\AusbildungsWegInterview.Infrastructure\AusbildungsWegInterview.Infrastructure.csproj" />
    <ProjectReference Include="..\AusbildungsWegInterview.Composition\AusbildungsWegInterview.Composition.csproj" />
    <ProjectReference Include="..\AusbildungsWegInterview.Localization\AusbildungsWegInterview.Localization.csproj" />
  </ItemGroup>

</Project>

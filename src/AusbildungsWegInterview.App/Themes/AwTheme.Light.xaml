<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         AusbildungsWeg brand theme
         Source of truth: https://ausbildungsweg.net (extracted from the
         site's live CSS design tokens, Oct 2026):
           background #f6f6fb   ink #17183a   muted #686b8c
           blue #6d5df6         blue deep #5847e8
           cyan #5a8df8         ai #9b7bf7
           success #1f9d72      warning #a3611c   danger #d9535d
           gradient neon 120deg #7b6cf6 / #5a8df8 / #9b7bf7
           font stack: system-ui, Segoe UI, ...
         ============================================================ -->

    <!-- palette -->
    <Color x:Key="AwBackgroundColor">#F6F6FB</Color>
    <Color x:Key="AwInkColor">#17183A</Color>
    <SolidColorBrush x:Key="AwBackgroundBrush" Color="{StaticResource AwBackgroundColor}"/>
    <SolidColorBrush x:Key="AwSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AwSurface2Brush" Color="#EFEFF7"/>
    <SolidColorBrush x:Key="AwInkBrush" Color="#17183A"/>
    <SolidColorBrush x:Key="AwInkSoftBrush" Color="#3D3F66"/>
    <SolidColorBrush x:Key="AwMutedBrush" Color="#686B8C"/>
    <SolidColorBrush x:Key="AwFaintBrush" Color="#9598B6"/>
    <SolidColorBrush x:Key="AwLineBrush" Color="#E5E5F1"/>
    <SolidColorBrush x:Key="AwLineStrongBrush" Color="#D3D4E6"/>
    <SolidColorBrush x:Key="AwAccentBrush" Color="#6D5DF6"/>
    <SolidColorBrush x:Key="AwAccentDeepBrush" Color="#5847E8"/>
    <SolidColorBrush x:Key="AwAccentSoftBrush" Color="#176D5DF6"/>
    <SolidColorBrush x:Key="AwCyanBrush" Color="#5A8DF8"/>
    <SolidColorBrush x:Key="AwAiBrush" Color="#9B7BF7"/>
    <SolidColorBrush x:Key="AwSuccessBrush" Color="#1F9D72"/>
    <SolidColorBrush x:Key="AwSuccessSoftBrush" Color="#1C1F9D72"/>
    <SolidColorBrush x:Key="AwWarningBrush" Color="#A3611C"/>
    <SolidColorBrush x:Key="AwWarningSoftBrush" Color="#1CA3611C"/>
    <SolidColorBrush x:Key="AwDangerBrush" Color="#D9535D"/>
    <SolidColorBrush x:Key="AwDangerSoftBrush" Color="#1AD9535D"/>
    <SolidColorBrush x:Key="AwDangerHoverBrush" Color="#2AD9535D"/>

    <!-- brand gradients (site neon / headline gradients, 120deg) -->
    <LinearGradientBrush x:Key="AwGradientNeon" StartPoint="0,0.15" EndPoint="1,0.85">
        <GradientStop Color="#7B6CF6" Offset="0"/>
        <GradientStop Color="#5A8DF8" Offset="0.55"/>
        <GradientStop Color="#9B7BF7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwGradientNeonDeep" StartPoint="0,0.15" EndPoint="1,0.85">
        <GradientStop Color="#6A5AE8" Offset="0"/>
        <GradientStop Color="#4C7DE8" Offset="0.55"/>
        <GradientStop Color="#8A6AE4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwGradientHeadline" StartPoint="0,0.2" EndPoint="1,0.8">
        <GradientStop Color="#4F3EE0" Offset="0"/>
        <GradientStop Color="#6D5DF6" Offset="0.48"/>
        <GradientStop Color="#9B7BF7" Offset="1"/>
    </LinearGradientBrush>

    <!-- window defaults -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource AwBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- typography -->
    <Style x:Key="AwSectionLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
    </Style>
    <Style x:Key="AwFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="AwHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource AwFaintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- surfaces -->
    <Style x:Key="AwCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="AwPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwSurface2Brush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    <Style x:Key="AwChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwSurface2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ============ buttons ============ -->
    <Style x:Key="AwButtonPrimary" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="12" Background="{StaticResource AwGradientNeon}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwGradientNeonDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwSurface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonDanger" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AwDangerSoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwDangerBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwDangerHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonGhost" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwSurface2Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ text box ============ -->
    <Style x:Key="AwTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ combo box ============ -->
    <Style x:Key="AwComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AwAccentDeepBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AwComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" CornerRadius="10" Background="{StaticResource AwSurfaceBrush}"
                                            BorderBrush="{StaticResource AwLineStrongBrush}" BorderThickness="1">
                                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                              Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="{StaticResource AwMutedBrush}" StrokeThickness="1.6"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,34,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="False" Focusable="False">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240"
                                    Background="{StaticResource AwSurfaceBrush}"
                                    BorderBrush="{StaticResource AwLineBrush}" BorderThickness="1" CornerRadius="12"
                                    Margin="0,6,0,0" Padding="0,4">
                                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ checkbox (fully themed: box, tick, hover, disabled) ============ -->
    <Style x:Key="AwCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource AwSurfaceBrush}"
                                BorderBrush="{StaticResource AwLineStrongBrush}" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Path x:Name="tick" Data="M 3.5,9.5 L 7.5,13.5 L 14.5,5" Stroke="White"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AwAccentBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ expander (fully themed header + content area) ============ -->
    <Style x:Key="AwExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderToggle" Focusable="True" ClickMode="Press"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="hb" Background="Transparent" Padding="2,6" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="chev" Grid.Column="0" Data="M 0 0 L 4.5 4.5 L 9 0"
                                                  Stroke="{StaticResource AwMutedBrush}" StrokeThickness="1.6"
                                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{StaticResource AwSurface2Brush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="chev" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="ContentArea" Visibility="Collapsed">
                            <ContentPresenter Margin="4,4,4,2"/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentArea" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===================== MAMADO shell (light glass + brand blue) ===================== -->
    <SolidColorBrush x:Key="AwShellBackgroundBrush" Color="#FFF4F7FE"/>
    <LinearGradientBrush x:Key="AwShellGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFEDF3FF" Offset="0"/>
        <GradientStop Color="#FFF7FAFF" Offset="0.55"/>
        <GradientStop Color="#FFE8F0FE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwGlassPanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#E8F2F7FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AwGlassBorderBrush" Color="#66A9C2E8"/>
    <SolidColorBrush x:Key="AwNavRailBrush" Color="#E6EAF3FF"/>
    <SolidColorBrush x:Key="AwNavHoverBrush" Color="#332563EB"/>
    <SolidColorBrush x:Key="AwNavSelectedBrush" Color="#332563EB"/>
    <SolidColorBrush x:Key="AwNeonBrush" Color="#FF1D4ED8"/>
    <SolidColorBrush x:Key="AwNeonSoftBrush" Color="#262563EB"/>
    <SolidColorBrush x:Key="AwNeonDeepBrush" Color="#FF1E40AF"/>
    <LinearGradientBrush x:Key="AwWaveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3B82F6" Offset="0"/>
        <GradientStop Color="#FF1D4ED8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwMicRingBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2563EB" Offset="0"/>
        <GradientStop Color="#FF7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AwChipBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="AwSegmentedSelectedBrush" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="AwSegmentedIdleBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="AwPillReadyBrush" Color="#FF15A34A"/>
    <SolidColorBrush x:Key="AwPillWarnBrush" Color="#FFB45309"/>
    <SolidColorBrush x:Key="AwPillFaultBrush" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="AwPillOffBrush" Color="#FF64748B"/>
    <DropShadowEffect x:Key="AwNeonGlow" Color="#FF93B4F5" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="AwPanelShadow" Color="#FF9FB3D9" BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>

    <Style x:Key="AwGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwGlassPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource AwPanelShadow}"/>
    </Style>

    <Style x:Key="AwNavGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource AwNeonBrush}"/>
    </Style>

    <Style x:Key="AwNavCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
    </Style>

    <Style x:Key="AwNavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0,12"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AwNavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AwNavSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwPillBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwChipBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <Style x:Key="AwSegmented" TargetType="RadioButton">
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource AwSegmentedIdleBrush}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AwNavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AwSegmentedSelectedBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

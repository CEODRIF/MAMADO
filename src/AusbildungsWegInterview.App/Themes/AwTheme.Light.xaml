<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         AusbildungsWeg brand theme
         Source of truth: https://ausbildungsweg.net (extracted from the
         site's live CSS design tokens, Oct 2026):
           background #f6f6fb   ink #17183a   muted #686b8c
           blue #6d5df6         blue deep #5847e8
           cyan #5a8df8         ai #9b7bf7
           success #1f9d72      warning #a3611c   danger #d9535d
           gradient neon 120deg #7b6cf6 / #5a8df8 / #9b7bf7
           font stack: system-ui, Segoe UI, ...
         ============================================================ -->

    <!-- palette -->
    <Color x:Key="AwBackgroundColor">#F6F6FB</Color>
    <Color x:Key="AwInkColor">#17183A</Color>
    <SolidColorBrush x:Key="AwBackgroundBrush" Color="{StaticResource AwBackgroundColor}"/>
    <SolidColorBrush x:Key="AwSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AwSurface2Brush" Color="#EFEFF7"/>
    <SolidColorBrush x:Key="AwInkBrush" Color="#17183A"/>
    <SolidColorBrush x:Key="AwInkSoftBrush" Color="#3D3F66"/>
    <SolidColorBrush x:Key="AwMutedBrush" Color="#686B8C"/>
    <SolidColorBrush x:Key="AwFaintBrush" Color="#9598B6"/>
    <SolidColorBrush x:Key="AwLineBrush" Color="#E5E5F1"/>
    <SolidColorBrush x:Key="AwLineStrongBrush" Color="#D3D4E6"/>
    <SolidColorBrush x:Key="AwAccentBrush" Color="#6D5DF6"/>
    <SolidColorBrush x:Key="AwAccentDeepBrush" Color="#5847E8"/>
    <SolidColorBrush x:Key="AwAccentSoftBrush" Color="#176D5DF6"/>
    <SolidColorBrush x:Key="AwCyanBrush" Color="#5A8DF8"/>
    <SolidColorBrush x:Key="AwAiBrush" Color="#9B7BF7"/>
    <SolidColorBrush x:Key="AwSuccessBrush" Color="#1F9D72"/>
    <SolidColorBrush x:Key="AwSuccessSoftBrush" Color="#1C1F9D72"/>
    <SolidColorBrush x:Key="AwWarningBrush" Color="#A3611C"/>
    <SolidColorBrush x:Key="AwWarningSoftBrush" Color="#1CA3611C"/>
    <SolidColorBrush x:Key="AwDangerBrush" Color="#D9535D"/>
    <SolidColorBrush x:Key="AwDangerSoftBrush" Color="#1AD9535D"/>
    <SolidColorBrush x:Key="AwDangerHoverBrush" Color="#2AD9535D"/>

    <!-- brand gradients (site neon / headline gradients, 120deg) -->
    <LinearGradientBrush x:Key="AwGradientNeon" StartPoint="0,0.15" EndPoint="1,0.85">
        <GradientStop Color="#7B6CF6" Offset="0"/>
        <GradientStop Color="#5A8DF8" Offset="0.55"/>
        <GradientStop Color="#9B7BF7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwGradientNeonDeep" StartPoint="0,0.15" EndPoint="1,0.85">
        <GradientStop Color="#6A5AE8" Offset="0"/>
        <GradientStop Color="#4C7DE8" Offset="0.55"/>
        <GradientStop Color="#8A6AE4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwGradientHeadline" StartPoint="0,0.2" EndPoint="1,0.8">
        <GradientStop Color="#4F3EE0" Offset="0"/>
        <GradientStop Color="#6D5DF6" Offset="0.48"/>
        <GradientStop Color="#9B7BF7" Offset="1"/>
    </LinearGradientBrush>

    <!-- window defaults -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource AwBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- typography -->
    <Style x:Key="AwSectionLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
    </Style>
    <Style x:Key="AwFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="AwHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource AwFaintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- surfaces -->
    <Style x:Key="AwCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="AwPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwSurface2Brush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    <Style x:Key="AwChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwSurface2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ============ buttons ============ -->
    <Style x:Key="AwButtonPrimary" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="12" Background="{StaticResource AwGradientNeon}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwGradientNeonDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwSurface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonDanger" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AwDangerSoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwDangerBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwDangerHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonGhost" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwSurface2Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ text box ============ -->
    <Style x:Key="AwTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ combo box ============ -->
    <Style x:Key="AwComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AwAccentDeepBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AwComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" CornerRadius="10" Background="{StaticResource AwSurfaceBrush}"
                                            BorderBrush="{StaticResource AwLineStrongBrush}" BorderThickness="1">
                                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                              Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="{StaticResource AwMutedBrush}" StrokeThickness="1.6"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,34,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="False" Focusable="False">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240"
                                    Background="{StaticResource AwSurfaceBrush}"
                                    BorderBrush="{StaticResource AwLineBrush}" BorderThickness="1" CornerRadius="12"
                                    Margin="0,6,0,0" Padding="0,4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ checkbox ============ -->
    <Style x:Key="AwCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ============ expander ============ -->
    <Style x:Key="AwExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
    </Style>

</ResourceDictionary>

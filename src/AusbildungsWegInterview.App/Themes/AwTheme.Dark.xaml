<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         AusbildungsWeg brand theme - DARK variant (same structure and key names as AwTheme.Light.xaml)
         Source of truth: https://ausbildungsweg.net (extracted from the
         site's live CSS design tokens, Oct 2026):
           background #f6f6fb   ink #17183a   muted #686b8c
           blue #6d5df6         blue deep #5847e8
           cyan #5a8df8         ai #9b7bf7
           success #1f9d72      warning #a3611c   danger #d9535d
           gradient neon 120deg #7b6cf6 / #5a8df8 / #9b7bf7
           font stack: system-ui, Segoe UI, ...
         ============================================================ -->

    <!-- palette -->
    <!-- Refined dark navy/slate: soft (not near-black), layered surfaces,
         coordinated borders. Contrast tuned for laptop displays. -->
    <Color x:Key="AwBackgroundColor">#1B1E2E</Color>
    <Color x:Key="AwInkColor">#F4F5FC</Color>
    <SolidColorBrush x:Key="AwBackgroundBrush" Color="{StaticResource AwBackgroundColor}"/>
    <SolidColorBrush x:Key="AwSurfaceBrush" Color="#242840"/>
    <SolidColorBrush x:Key="AwSurface2Brush" Color="#2D3251"/>
    <SolidColorBrush x:Key="AwInkBrush" Color="#F4F5FC"/>
    <SolidColorBrush x:Key="AwInkSoftBrush" Color="#D4D6E9"/>
    <SolidColorBrush x:Key="AwMutedBrush" Color="#A9ADC9"/>
    <SolidColorBrush x:Key="AwFaintBrush" Color="#8085A8"/>
    <SolidColorBrush x:Key="AwLineBrush" Color="#353B59"/>
    <SolidColorBrush x:Key="AwLineStrongBrush" Color="#474E78"/>
    <SolidColorBrush x:Key="AwAccentBrush" Color="#8B7EF7"/>
    <SolidColorBrush x:Key="AwAccentDeepBrush" Color="#7466E9"/>
    <SolidColorBrush x:Key="AwAccentSoftBrush" Color="#338B7EF7"/>
    <SolidColorBrush x:Key="AwCyanBrush" Color="#6F9BFA"/>
    <SolidColorBrush x:Key="AwAiBrush" Color="#A98FF8"/>
    <SolidColorBrush x:Key="AwSuccessBrush" Color="#4CC99B"/>
    <SolidColorBrush x:Key="AwSuccessSoftBrush" Color="#2E4CC99B"/>
    <SolidColorBrush x:Key="AwWarningBrush" Color="#E0A55E"/>
    <SolidColorBrush x:Key="AwWarningSoftBrush" Color="#2EE0A55E"/>
    <SolidColorBrush x:Key="AwDangerBrush" Color="#EF7C88"/>
    <SolidColorBrush x:Key="AwDangerSoftBrush" Color="#30EF7C88"/>
    <SolidColorBrush x:Key="AwDangerHoverBrush" Color="#3EEF7C88"/>

    <!-- brand gradients (site neon / headline gradients, 120deg) -->
    <LinearGradientBrush x:Key="AwGradientNeon" StartPoint="0,0.15" EndPoint="1,0.85">
        <GradientStop Color="#8073EC" Offset="0"/>
        <GradientStop Color="#5F8DE8" Offset="0.55"/>
        <GradientStop Color="#9679EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwGradientNeonDeep" StartPoint="0,0.15" EndPoint="1,0.85">
        <GradientStop Color="#6F62DC" Offset="0"/>
        <GradientStop Color="#5280D8" Offset="0.55"/>
        <GradientStop Color="#8468DE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwGradientHeadline" StartPoint="0,0.2" EndPoint="1,0.8">
        <GradientStop Color="#6F62DC" Offset="0"/>
        <GradientStop Color="#8073EC" Offset="0.48"/>
        <GradientStop Color="#9679EE" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================
         Vision glass layers (premium overlay design): translucent
         layered surfaces, thin luminous borders, static ambient
         light. WPF has no backdrop blur, so glass = alpha-layered
         gradients over the window background (zero continuous
         rendering cost). Both themes define the SAME key set.
         ============================================================ -->
    <LinearGradientBrush x:Key="AwGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#408B7EF7" Offset="0"/>
        <GradientStop Color="#293A4166" Offset="0.22"/>
        <GradientStop Color="#1F3A4166" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AwGlassDeepBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#30F4F5FC" Offset="0"/>
        <GradientStop Color="#19F4F5FC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AwLumenBrush" Color="#2E8B7EF7"/>
    <SolidColorBrush x:Key="AwLumenStrongBrush" Color="#808B7EF7"/>
    <Color x:Key="AwShadowColor">#80000000</Color>
    <DropShadowEffect x:Key="AwShadow" Color="#80000000" BlurRadius="16" ShadowDepth="3" Direction="270"/>
    <RadialGradientBrush x:Key="AwAmbientGlow" GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.95" RadiusY="0.8">
        <GradientStop Color="#268B7EF7" Offset="0"/>
        <GradientStop Color="#125F8DE8" Offset="0.45"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- high-contrast themed focus outline (visible keyboard focus for every
         focusable control; inherited from the Window default style below) -->
    <Style x:Key="AwFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" BorderThickness="2"
                            BorderBrush="{StaticResource AwLumenStrongBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- window defaults -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource AwBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AwFocusVisual}"/>
    </Style>

    <!-- typography -->
    <Style x:Key="AwSectionLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
    </Style>
    <Style x:Key="AwFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="AwHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource AwFaintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- surfaces: layered translucent glass + thin luminous border + soft shadow -->
    <Style x:Key="AwCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLumenBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect" Value="{StaticResource AwShadow}"/>
    </Style>
    <Style x:Key="AwPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwGlassDeepBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLumenBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    <Style x:Key="AwChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AwGlassDeepBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLumenBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ============ buttons ============ -->
    <Style x:Key="AwButtonPrimary" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="12" Background="{StaticResource AwGradientNeon}"
                            Effect="{StaticResource AwShadow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwGradientNeonDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AwGlassDeepBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLumenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwSurface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonDanger" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AwDangerSoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwDangerBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwDangerHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwButtonGhost" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AwMutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwSurface2Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ text box ============ -->
    <Style x:Key="AwTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ combo box ============ -->
    <Style x:Key="AwComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AwAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AwAccentDeepBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AwComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource AwSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AwLineStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AwComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" CornerRadius="10" Background="{StaticResource AwSurfaceBrush}"
                                            BorderBrush="{StaticResource AwLineStrongBrush}" BorderThickness="1">
                                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                              Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="{StaticResource AwMutedBrush}" StrokeThickness="1.6"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,34,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="False" Focusable="False">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240"
                                    Background="{StaticResource AwSurfaceBrush}"
                                    BorderBrush="{StaticResource AwLumenStrongBrush}" BorderThickness="1" CornerRadius="12"
                                    Margin="0,6,0,0" Padding="0,4" Effect="{StaticResource AwShadow}">
                                <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ checkbox (fully themed: box, tick, hover, disabled) ============ -->
    <Style x:Key="AwCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource AwInkSoftBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource AwSurfaceBrush}"
                                BorderBrush="{StaticResource AwLineStrongBrush}" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Path x:Name="tick" Data="M 3.5,9.5 L 7.5,13.5 L 14.5,5" Stroke="White"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AwAccentBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AwAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ expander (fully themed header + content area) ============ -->
    <Style x:Key="AwExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource AwInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderToggle" Focusable="True" ClickMode="Press"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="hb" Background="Transparent" Padding="2,6" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="chev" Grid.Column="0" Data="M 0 0 L 4.5 4.5 L 9 0"
                                                  Stroke="{StaticResource AwMutedBrush}" StrokeThickness="1.6"
                                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{StaticResource AwSurface2Brush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="chev" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="ContentArea" Visibility="Collapsed">
                            <ContentPresenter Margin="4,4,4,2"/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentArea" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
